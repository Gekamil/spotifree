<?xml version="1.0" encoding="utf-8"?>
<!-- Turntable widget (4x2): blurred album art + dynamic gradient backdrop, smoked glass plinth,
     native 60 FPS smooth vinyl platter + optical label sheen rotation (no choppy ViewFlipper),
     tonearm, live chronometer, lyric line, progress bar & controls. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/spotifree_widget_shape" />

    <ImageView
        android:id="@+id/widget_bg_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/spotifree_widget_shade" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="11dp">

        <!-- Smoked glass deck: base, smooth 60 FPS spinning platter/grooves, crisp center cover + sheen, tonearm -->
        <FrameLayout
            android:id="@+id/tt_deck"
            android:layout_width="102dp"
            android:layout_height="102dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/spotifree_tt_plinth" />

            <FrameLayout
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:layout_gravity="center">

                <ProgressBar
                    android:id="@+id/tt_spin"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="true"
                    android:indeterminateBehavior="repeat"
                    android:indeterminateDrawable="@drawable/spotifree_vinyl_spin"
                    android:indeterminateDuration="2600"
                    android:indeterminateOnly="true"
                    android:indeterminateTint="#FFFFFFFF"
                    android:indeterminateTintMode="multiply"
                    android:interpolator="@android:anim/linear_interpolator"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/tt_disc"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/spotifree_vinyl_disc" />

                <ImageView
                    android:id="@+id/tt_label"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/spotifree_vinyl_label" />

                <ProgressBar
                    android:id="@+id/tt_label_sheen"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateBehavior="repeat"
                    android:indeterminateDrawable="@drawable/spotifree_label_sheen"
                    android:indeterminateDuration="2600"
                    android:indeterminateOnly="true"
                    android:indeterminateTint="#FFFFFFFF"
                    android:indeterminateTintMode="multiply"
                    android:interpolator="@android:anim/linear_interpolator"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageView
                android:id="@+id/tt_arm"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/spotifree_tonearm_off" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/widget_live_ring"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="6dp"
                    android:indeterminate="true"
                    android:indeterminateDrawable="@drawable/spotifree_live_ring"
                    android:indeterminateOnly="true"
                    android:indeterminateTint="#FFFFFFFF"
                    android:indeterminateTintMode="multiply"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_state"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Tocadiscos"
                    android:textColor="#D9FFFFFF"
                    android:textSize="11sp" />

                <Chronometer
                    android:id="@+id/widget_chronometer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#E6FFFFFF"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_text"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowRadius="6"
                    android:text="Spotifree"
                    android:textColor="#FFFFFF"
                    android:textSize="16.5sp" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1.5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#E0FFFFFF"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/widget_lyrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:fontFamily="sans-serif-medium"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="#9EFFB8"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/widget_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginBottom="7dp"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/spotifree_widget_progress" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_prev"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/spotifree_widget_btn_bg"
                    android:contentDescription="Anterior"
                    android:padding="8dp"
                    android:src="@drawable/ic_stat_prev" />

                <ImageView
                    android:id="@+id/widget_play"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/spotifree_widget_play_bg"
                    android:contentDescription="Reproducir"
                    android:padding="12dp"
                    android:src="@drawable/ic_stat_play" />

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/spotifree_widget_btn_bg"
                    android:contentDescription="Siguiente"
                    android:padding="8dp"
                    android:src="@drawable/ic_stat_next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
