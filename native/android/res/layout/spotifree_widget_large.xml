<?xml version="1.0" encoding="utf-8"?>
<!-- Widget, large (4x2 and bigger): big cover, app icon, song, artist and big controls -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/spotifree_widget_shape" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/spotifree_widget_shade" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:maxWidth="150dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher_app_default" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_logo"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Spotifree"
                    android:src="@mipmap/ic_launcher_app_default" />

                <TextView
                    android:id="@+id/widget_state"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Spotifree"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_text"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:maxLines="2"
                    android:text="Spotifree"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#D9FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_prev"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Anterior"
                    android:padding="9dp"
                    android:src="@drawable/ic_stat_prev" />

                <ImageView
                    android:id="@+id/widget_play"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/spotifree_widget_play_bg"
                    android:contentDescription="Reproducir"
                    android:padding="14dp"
                    android:src="@drawable/ic_stat_play" />

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Siguiente"
                    android:padding="9dp"
                    android:src="@drawable/ic_stat_next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
