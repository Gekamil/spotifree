<?xml version="1.0" encoding="utf-8"?>
<!-- Widget, large (4x2+): blurred cover backdrop, gradient glass, live wave ring, chronometer, progress & controls -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/spotifree_widget_shape" />

    <ImageView
        android:id="@+id/widget_bg_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/spotifree_widget_shade" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:maxWidth="144dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher_app_default" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_logo"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Spotifree"
                    android:src="@mipmap/ic_launcher_app_default" />

                <ProgressBar
                    android:id="@+id/widget_live_ring"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginStart="6dp"
                    android:indeterminate="true"
                    android:indeterminateDrawable="@drawable/spotifree_live_ring"
                    android:indeterminateOnly="true"
                    android:indeterminateTint="#FFFFFFFF"
                    android:indeterminateTintMode="multiply"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_state"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Spotifree"
                    android:textColor="#D9FFFFFF"
                    android:textSize="11sp" />

                <Chronometer
                    android:id="@+id/widget_chronometer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#E6FFFFFF"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_text"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:maxLines="2"
                    android:shadowColor="#66000000"
                    android:shadowRadius="6"
                    android:text="Spotifree"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#E0FFFFFF"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/widget_lyrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#9EFFB8"
                    android:textSize="11.5sp"
                    android:visibility="gone" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/widget_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3.5dp"
                android:layout_marginBottom="8dp"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/spotifree_widget_progress" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_prev"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/spotifree_widget_btn_bg"
                    android:contentDescription="Anterior"
                    android:padding="9dp"
                    android:src="@drawable/ic_stat_prev" />

                <ImageView
                    android:id="@+id/widget_play"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/spotifree_widget_play_bg"
                    android:contentDescription="Reproducir"
                    android:padding="13dp"
                    android:src="@drawable/ic_stat_play" />

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/spotifree_widget_btn_bg"
                    android:contentDescription="Siguiente"
                    android:padding="9dp"
                    android:src="@drawable/ic_stat_next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
