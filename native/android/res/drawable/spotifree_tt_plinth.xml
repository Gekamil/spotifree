<?xml version="1.0" encoding="utf-8"?>
<!-- Smoked frosted glass turntable plinth so the blurred album backdrop shines through behind it -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#881C1C22"
        android:centerColor="#A6111115"
        android:endColor="#CC08080B"
        android:type="linear" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="#38FFFFFF" />
</shape>
