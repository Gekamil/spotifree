<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Google Assistant, Gemini & Android AI: "Pon música en Spotifree", "Reproduce <canción/artista> en Spotifree" -->
    <capability android:name="actions.intent.PLAY_MUSIC">
        <intent
            android:action="android.media.action.MEDIA_PLAY_FROM_SEARCH"
            android:targetPackage="com.spotifree.music"
            android:targetClass="com.spotifree.music.MainActivity">
            <parameter
                android:name="audio.name"
                android:key="query" />
        </intent>
        <intent
            android:action="android.media.action.MEDIA_PLAY_FROM_SEARCH"
            android:targetPackage="com.spotifree.music"
            android:targetClass="com.spotifree.music.MainActivity">
            <parameter
                android:name="musicRecording.name"
                android:key="query" />
        </intent>
        <intent
            android:action="android.media.action.MEDIA_PLAY_FROM_SEARCH"
            android:targetPackage="com.spotifree.music"
            android:targetClass="com.spotifree.music.MainActivity">
            <parameter
                android:name="artist.name"
                android:key="query" />
        </intent>
        <intent
            android:action="android.media.action.MEDIA_PLAY_FROM_SEARCH"
            android:targetPackage="com.spotifree.music"
            android:targetClass="com.spotifree.music.MainActivity">
            <parameter
                android:name="album.name"
                android:key="query" />
        </intent>
        <intent
            android:action="android.media.action.MEDIA_PLAY_FROM_SEARCH"
            android:targetPackage="com.spotifree.music"
            android:targetClass="com.spotifree.music.MainActivity">
            <parameter
                android:name="playlist.name"
                android:key="query" />
        </intent>
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.spotifree.music"
            android:targetClass="com.spotifree.music.MainActivity">
            <url-template android:value="spotifree://play?q={query}" />
            <parameter
                android:name="audio.name"
                android:key="query" />
        </intent>
    </capability>

    <!-- In-app voice feature navigation -->
    <capability android:name="actions.intent.OPEN_APP_FEATURE">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.spotifree.music"
            android:targetClass="com.spotifree.music.MainActivity">
            <parameter
                android:name="feature"
                android:key="feature" />
        </intent>
    </capability>

    <!-- Static Shortcut: Pon música -->
    <shortcut
        android:shortcutId="shortcut_play_music"
        android:enabled="true"
        android:icon="@drawable/ic_stat_spotifree"
        android:shortLabel="@string/shortcut_play_music"
        android:longLabel="@string/shortcut_play_music_long">
        <intent
            android:action="android.media.action.MEDIA_PLAY_FROM_SEARCH"
            android:targetPackage="com.spotifree.music"
            android:targetClass="com.spotifree.music.MainActivity" />
        <capability-binding android:key="actions.intent.PLAY_MUSIC" />
    </shortcut>

    <!-- Static Shortcut: Reproducir música -->
    <shortcut
        android:shortcutId="shortcut_reproducir_musica"
        android:enabled="true"
        android:icon="@drawable/ic_stat_spotifree"
        android:shortLabel="@string/shortcut_reproducir_musica"
        android:longLabel="@string/shortcut_reproducir_musica_long">
        <intent
            android:action="android.media.action.MEDIA_PLAY_FROM_SEARCH"
            android:targetPackage="com.spotifree.music"
            android:targetClass="com.spotifree.music.MainActivity" />
        <capability-binding android:key="actions.intent.PLAY_MUSIC" />
    </shortcut>
</shortcuts>
