{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/token",
      "destination": "/api/token"
    },
    {
      "source": "/api/login",
      "destination": "/api/login"
    },
    {
      "source": "/api/spotify/login",
      "destination": "/api/login"
    },
    {
      "source": "/api/spotify/token",
      "destination": "/api/token"
    },
    {
      "source": "/api/spotify/extract-session",
      "destination": "/api/extract-session"
    },
    {
      "source": "/api/extract-session",
      "destination": "/api/extract-session"
    },
    {
      "source": "/api/lyrics",
      "destination": "/api/lyrics"
    },
    {
      "source": "/api/spotify/playlist/(.*)",
      "destination": "/api/playlist?id=$1"
    },
    {
      "source": "/api/playlist",
      "destination": "/api/playlist"
    },
    {
      "source": "/api/audio/(.*)",
      "destination": "/api/audio/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://spotifree-backend-o4a7.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
