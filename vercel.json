{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/instalar",
      "destination": "/instalar.html"
    },
    {
      "source": "/install",
      "destination": "/instalar.html"
    },
    {
      "source": "/api/token",
      "destination": "/api/token"
    },
    {
      "source": "/api/login",
      "destination": "/api/login"
    },
    {
      "source": "/api/spotify/login",
      "destination": "/api/login"
    },
    {
      "source": "/api/spotify/token",
      "destination": "/api/token"
    },
    {
      "source": "/api/spotify/extract-session",
      "destination": "/api/login"
    },
    {
      "source": "/api/extract-session",
      "destination": "/api/login"
    },
    {
      "source": "/api/lyrics",
      "destination": "/api/lyrics"
    },
    {
      "source": "/api/canvas",
      "destination": "/api/metadata?action=canvas"
    },
    {
      "source": "/api/audio-features",
      "destination": "/api/metadata?action=audio-features"
    },
    {
      "source": "/api/artist-image",
      "destination": "/api/metadata?action=artist-image"
    },
    {
      "source": "/api/audio/stream",
      "destination": "/api/audio?action=stream"
    },
    {
      "source": "/api/audio/resolve",
      "destination": "/api/audio?action=resolve"
    },
    {
      "source": "/api/audio/(.*)",
      "destination": "/api/audio?action=$1"
    },
    {
      "source": "/api/spotify/playlist/(.*)",
      "destination": "/api/playlist?id=$1"
    },
    {
      "source": "/api/playlist",
      "destination": "/api/playlist"
    },
    {
      "source": "/api/user-profile",
      "destination": "/api/user-profile"
    },
    {
      "source": "/api/auth",
      "destination": "/api/auth"
    },
    {
      "source": "/api/spotify/search",
      "destination": "/api/search"
    },
    {
      "source": "/api/search",
      "destination": "/api/search"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://spotifree-backend-o4a7.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
