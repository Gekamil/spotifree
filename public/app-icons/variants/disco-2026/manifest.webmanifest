{
  "id": "/",
  "name": "Spotifree",
  "short_name": "Spotifree",
  "description": "Spotifree - Reproductor web: música para todos",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "window-controls-overlay",
    "minimal-ui",
    "browser"
  ],
  "background_color": "#121212",
  "theme_color": "#121212",
  "orientation": "portrait-primary",
  "prefer_related_applications": false,
  "categories": [
    "music",
    "entertainment",
    "audio"
  ],
  "icons": [
    {
      "src": "/app-icons/variants/disco-2026/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app-icons/variants/disco-2026/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app-icons/variants/disco-2026/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/app-icons/variants/disco-2026/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/app-icons/variants/disco-2026/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "Buscar",
      "short_name": "Buscar",
      "description": "Buscar canciones, artistas y álbumes",
      "url": "/?tab=search",
      "icons": [
        {
          "src": "/app-icons/variants/disco-2026/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Tu Biblioteca",
      "short_name": "Biblioteca",
      "description": "Acceder a tus playlists y canciones favoritas",
      "url": "/?tab=library",
      "icons": [
        {
          "src": "/app-icons/variants/disco-2026/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
